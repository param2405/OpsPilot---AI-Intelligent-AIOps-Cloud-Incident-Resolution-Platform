# =============================================================================
# OpsPilot AI Local Environment Configuration (.env.example)
# =============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database Configuration (pgvector/pgvector:pg16)
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev_password
POSTGRES_DB=opspilot
POSTGRES_PORT=5432

# Redis Cache and Rate Limiter Configuration
REDIS_PORT=6379

# MLflow Tracking Server Configuration
MLFLOW_PORT=5000

# Backend FastAPI Service Port
API_PORT=8000

# Frontend Web Application Ports
WEB_PORT=80
VITE_DEV_PORT=5173

# Background Worker Settings
WORKER_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_FILE=/tmp/opspilot/worker_heartbeat
