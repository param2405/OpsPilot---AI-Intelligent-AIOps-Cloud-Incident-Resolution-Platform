# =============================================================================
# OpsPilot AI — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and customize values for your deployment.
# Never commit the populated .env file to version control.
# =============================================================================

# Application Runtime Mode (development, staging, or production)
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Configuration (pgvector/pgvector:pg16)
# Note: Inside Docker networks, use POSTGRES_HOST=postgres (do NOT use localhost or 127.0.0.1)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=opspilot

# Redis Cache & Queue Broker
# Note: Inside Docker networks, use REDIS_HOST=redis (do NOT use localhost or 127.0.0.1)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MLflow Experiment Tracking Configuration
# For single-server EC2 deployment, uses local SQLite persistence (no separate container needed)
MLFLOW_TRACKING_URI=sqlite:////app/data/mlflow.db

# Frontend Web Service Port on EC2 Host
# Only port 80 is exposed publicly. Nginx reverse-proxies /api/ calls to the API container.
WEB_PORT=80

# Frontend API Base URL
# Leave empty for production so the React client makes relative /api/* requests via Nginx
VITE_API_BASE_URL=

# Backend CORS Allowed Origins
# For production where React and FastAPI share the same host, list the public domain or IP
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Background Asynchronous Worker Configuration
WORKER_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_FILE=/tmp/opspilot/worker_heartbeat
